      "transformation": "Set same-origin PYGPI before import_site preloads the embedded template.",
      "patch": {
        "after": "import __EMSCRIPTEN__ as platform",
        "inserted_source": "# Night Survivors: set the package root before import_site preloads the\n# embedded HTML bootstrap. Setting PYGPI in that bootstrap is already too late.\nif not aio.cross.simulator:\n    _night_runtime_cdn = str(platform.window.config.cdn)\n    if not _night_runtime_cdn.endswith(\"/0.9.3/\"):\n        raise RuntimeError(\"Expected the vendored pygbag 0.9.3 runtime URL\")\n    os.environ[\"PYGPI\"] = _night_runtime_cdn[:-len(\"0.9.3/\")]\n    del _night_runtime_cdn\n"
      },
      "bytes": 50882,
      "sha256": "c5c58db22ad7b61fb75e4cd101c11e5ea5592f0fd9c475bd4e80a95050e27e9d"
    },
